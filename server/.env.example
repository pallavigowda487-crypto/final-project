PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/exam-platform
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Local: http://localhost:5173 | Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
API_KEY=your-internal-api-key-for-frontend-backend

# AI Provider: groq | gemini | openai
# Recommended: groq for chat (fast) + gemini for embeddings (RAG)
AI_PROVIDER=groq
EMBEDDING_PROVIDER=gemini

# Groq — https://console.groq.com (chat / question gen / evaluation)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey (embeddings + optional chat)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# OpenAI (optional fallback)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=exam-syllabus-index
# Use 768 for Gemini embeddings, 1536 for OpenAI embeddings
# PINECONE_DIMENSION=768

# LangSmith — https://smith.langchain.com (trace LLM / RAG / evaluation runs)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_PROJECT=exam-platform

# Use 4 or less on Vercel Hobby (request body limit ~4.5 MB)
MAX_FILE_SIZE_MB=20
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
